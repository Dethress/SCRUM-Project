void myLowLevelRedLedInit(void)
{

  /* Enable the GPIO_LED clock */
	RCC->APB2ENR |= 1 << 5;

	//COnfigure PD3 as output 2MHz:
//	GPIOD->CRL |= 0b00000000000000000010000000000000;
//	GPIOD->CRL |= 0x00002000;
	GPIOD->CRL |= 1 << 13; //przesuniecie o 12 miejsc z ostatniego miejsca
	//set bit 12 to '0':
	//GPIOD->CRL &=0b11111111111111111111011111111111;
	//GPIOD->CRL &=~ 0b00000000000000000001000000000000;
	GPIOD->CRL &=~(1<<12);

	//Configure PD3 as output push/pull
	//set bits 15 and 14 to '00":
	GPIOD->CRL &=~(1<<15);
	GPIOD->CRL &=~(1<<14);


	}

void gameSetup(void)
	{
	uint16_t i = 0;

	//lcd clean
	BSP_LCD_Clear(LCD_COLOR_BLACK);
	//draw the grid

	BSP_LCD_SetTextColor(LCD_COLOR_ORANGE);
//LCD_COLOR_BLACK

	for(i=0; i <240; i += SQ_SIZE)
		BSP_LCD_DrawHLine(0,i,320);
	for(i=0; i <320; i+=SQ_SIZE)
		BSP_LCD_DrawVLine(i,0,240);
		//draw the grid
		//BSP_LCD_DrawHline
	gameBoard[0][0] = 1;
	pacmanPos.row = 0;
	pacmanPos.col = 0;

	BSP_LCD_SetTextColor(LCD_COLOR_YELLOW);
	myFillRect(1,1,SQ_SIZE-1, SQ_SIZE-1);
	}


void moveRight(void)
{
	//erase pac-man at its current position:

	BSP_LCD_SetTextColor(LCD_COLOR_BLACK);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

	gameBoard[pacmanPos.row][pacmanPos.col] = 0;
	//update pacmans position:

	pacmanPos.col++;

	if (pacmanPos.col==NCOL)
		pacmanPos.col=0;

	gameBoard[pacmanPos.row][pacmanPos.col] = 1;
	// draw him again
	BSP_LCD_SetTextColor(LCD_COLOR_YELLOW);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

}

void moveLeft(void)
{
	//erase pac-man at its current position:

	BSP_LCD_SetTextColor(LCD_COLOR_BLACK);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

	gameBoard[pacmanPos.row][pacmanPos.col] = 0;
	//update pacmans position:

	pacmanPos.col--;

	if (pacmanPos.col==0)
		pacmanPos.col=NCOL;

	gameBoard[pacmanPos.row][pacmanPos.col] = 1;
	// draw him again
	BSP_LCD_SetTextColor(LCD_COLOR_YELLOW);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

}

void moveDown(void)
{
	//erase pac-man at its current position:

	BSP_LCD_SetTextColor(LCD_COLOR_BLACK);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

	gameBoard[pacmanPos.row][pacmanPos.col] = 0;
	//update pacmans position:

	pacmanPos.row++;

	if (pacmanPos.row==NROW)
		pacmanPos.row=0;

	gameBoard[pacmanPos.row][pacmanPos.col] = 1;
	// draw him again
	BSP_LCD_SetTextColor(LCD_COLOR_YELLOW);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

}


void moveUp(void)
{
	//erase pac-man at its current position:

	BSP_LCD_SetTextColor(LCD_COLOR_BLACK);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

	gameBoard[pacmanPos.row][pacmanPos.col] = 0;
	//update pacmans position:

	pacmanPos.row--;

	if (pacmanPos.row==NROW)
		pacmanPos.row=0;

	gameBoard[pacmanPos.row][pacmanPos.col] = 1;
	// draw him again
	BSP_LCD_SetTextColor(LCD_COLOR_YELLOW);
	myFillRect(pacmanPos.col*SQ_SIZE+1, pacmanPos.row*SQ_SIZE+1, SQ_SIZE-1, SQ_SIZE-1);

}



void myFillRect(uint16_t Xpos, uint16_t Ypos, uint16_t Width, uint16_t Height)
{
  while (Height--)
  {
    BSP_LCD_DrawHLine(Xpos, Ypos++, Width);
  }
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_PIN)
{
	if (GPIO_PIN == IOE_IT_PIN)
	{
	switch(JoyState)
		    {
		    case JOY_UP:
		     moveUp();
		      break;
		    case JOY_DOWN:
		    	moveDown();
		      break;
		    case JOY_LEFT:
		     //moveLeft();
		    moveLeft();
		     break;
		    case JOY_RIGHT:
		      moveRight();
		      break;
		    default:
		      break;
		    }
	}

}

